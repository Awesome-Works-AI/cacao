---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import type { UiKey } from "~/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

const items: UiKey[] = [
  "enemy.item1",
  "enemy.item2",
  "enemy.item3",
  "enemy.item4",
  "enemy.item5",
  "enemy.item6",
  "enemy.item7",
  "enemy.item8",
];
---

<section class="relative bg-ink-50 py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      {/* LEFT — aerial photo with dark wash + dossier stamp */}
      <div class="lg:col-span-5">
        <div class="photo-card photo-tint-cocoa relative h-[280px] md:h-[420px] lg:h-full lg:min-h-[480px]">
          <img
            src={`${base}aerial.jpg`}
            alt=""
            loading="lazy"
            decoding="async"
          />
          <div class="absolute left-4 top-4 z-10">
            <span class="stamp stamp-warn">
              ⚠ {lang === "vi" ? "Vùng có rủi ro" : "Risk zone"}
            </span>
          </div>
          <div class="absolute bottom-5 left-5 right-5 z-10 text-white">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/70">
              {lang === "vi" ? "Cảnh báo phá rừng · 2020+" : "Deforestation alert · 2020+"}
            </div>
            <div class="mt-1 text-2xl font-bold tracking-tight md:text-3xl">
              GLAD · RADD · JRC TMF
            </div>
          </div>
        </div>
      </div>

      {/* RIGHT — heading + 8 enemy bullets */}
      <div class="lg:col-span-7">
        <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">
          02 / {lang === "vi" ? "Những gì sẽ chặn bạn" : "What blocks you"}
        </div>
        <h2 class="mt-4 text-balance text-3xl font-bold tracking-tight text-ink-900 md:text-5xl">
          {t("enemy.heading")}
        </h2>
        <p class="mt-5 max-w-2xl text-lg text-ink-600">{t("enemy.subhead")}</p>

        <ul class="mt-10 grid grid-cols-1 gap-x-10 gap-y-4 sm:grid-cols-2">
          {
            items.map((key, i) => (
              <li class="flex items-start gap-3 border-t border-ink-200 pt-3">
                <span class="mt-0.5 font-mono text-[10px] font-bold tracking-wider text-ink-400">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <svg
                  class="mt-1 h-4 w-4 flex-none text-orange-600"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="6" y1="6" x2="18" y2="18" />
                  <line x1="18" y1="6" x2="6" y2="18" />
                </svg>
                <span class="text-base leading-relaxed text-ink-800">{t(key)}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
