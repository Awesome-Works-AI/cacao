---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import type { UiKey } from "~/i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL;

interface Props {
  tag: UiKey;
  title: UiKey;
  body: UiKey;
  bullets: [UiKey, UiKey, UiKey];
  reverse?: boolean;
  visual: "gps" | "dds" | "risk";
}

const { tag, title, body, bullets, reverse = false, visual } = Astro.props;

const photoSrc = {
  gps:  `${base}plots.jpg`,
  dds:  `${base}farmer.jpg`,
  risk: `${base}aerial.jpg`,
}[visual];
---

<div class={`grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-16 ${reverse ? "lg:[&>*:first-child]:order-2" : ""}`}>
  {/* COPY */}
  <div class="lg:col-span-5">
    <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-blue-700">
      {t(tag)}
    </div>
    <h3 class="mt-4 text-3xl font-bold tracking-tight text-ink-900 md:text-4xl">{t(title)}</h3>
    <p class="mt-5 text-lg text-ink-600 leading-relaxed">{t(body)}</p>

    <ul class="mt-7 space-y-3">
      {
        bullets.map((b) => (
          <li class="flex items-start gap-3 border-t border-ink-200 pt-3 text-ink-800">
            <svg
              class="mt-1 h-4 w-4 flex-none text-green-700"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <polyline points="20 6 9 17 4 12" />
            </svg>
            <span>{t(b)}</span>
          </li>
        ))
      }
    </ul>
  </div>

  {/* PHOTO with module-specific overlay */}
  <div class="lg:col-span-7">
    <div class="photo-card relative h-[360px] md:h-[460px] lg:h-[520px]">
      <img src={photoSrc} alt="" loading="lazy" decoding="async" />

      {visual === "gps" && (
        <>
          {/* Polygon SVG overlay — draws plot boundaries on the photo */}
          <svg
            class="polygon-overlay"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <polygon
              points="12,18 38,12 46,32 32,48 14,42"
              fill="rgb(16 185 129 / 0.18)"
              stroke="#10B981"
              stroke-width="0.6"
              stroke-dasharray="1.5 1.2"
              vector-effect="non-scaling-stroke"
            />
            <polygon
              points="52,22 78,18 86,36 70,46 56,40"
              fill="rgb(16 185 129 / 0.18)"
              stroke="#10B981"
              stroke-width="0.6"
              stroke-dasharray="1.5 1.2"
              vector-effect="non-scaling-stroke"
            />
            <polygon
              points="28,62 64,58 72,82 38,86"
              fill="rgb(251 146 60 / 0.18)"
              stroke="#F97316"
              stroke-width="0.6"
              stroke-dasharray="1.5 1.2"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <div class="absolute right-4 top-4 z-10">
            <span class="stamp stamp-ok">✓ WGS84 · TRACES NT</span>
          </div>
          <div class="absolute left-4 bottom-4 z-10">
            <span class="stamp stamp-light">142 / 142 plots</span>
          </div>
        </>
      )}

      {visual === "dds" && (
        <>
          <div class="absolute inset-0 z-0 photo-fade-b"></div>
          <div class="absolute right-4 top-4 z-10">
            <span class="stamp stamp-light">DDS · LOT/2026/CCA/0871</span>
          </div>
          <div class="absolute bottom-5 left-5 right-5 z-10 max-w-md bg-white/95 p-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
              {t("mock.dds.question")}
            </div>
            <div class="mt-2 text-lg font-bold text-ink-900">{t("mock.dds.answer_lead")}</div>
            <div class="mt-1 text-2xl font-black tracking-tight text-green-700">{t("mock.dds.answer_value")}</div>
            <div class="mt-2 text-xs text-ink-500">{t("mock.dds.source")}</div>
          </div>
        </>
      )}

      {visual === "risk" && (
        <>
          <div class="absolute inset-0 z-0 photo-tint-cocoa"></div>
          <div class="absolute left-4 top-4 z-10">
            <span class="stamp stamp-warn">⚠ 1 ALERT · BLOCK C-07</span>
          </div>
          <div class="absolute bottom-5 left-5 right-5 z-10 bg-white/95 p-5">
            <div class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
              {t("mock.risk.header")}
            </div>
            <div class="mt-2 space-y-1.5">
              <div class="flex items-center justify-between text-sm">
                <span class="text-ink-800">{t("mock.risk.row1_label")}</span>
                <span class="font-semibold text-green-700">{t("mock.risk.row1_status")}</span>
              </div>
              <div class="flex items-center justify-between text-sm">
                <span class="text-ink-800">{t("mock.risk.row2_label")}</span>
                <span class="font-semibold text-orange-600">{t("mock.risk.row2_status")}</span>
              </div>
              <div class="flex items-center justify-between border-t border-ink-200 pt-1.5 text-sm">
                <span class="text-ink-600">{t("mock.risk.row3_label")}</span>
                <span class="font-semibold text-ink-800">{t("mock.risk.row3_value")}</span>
              </div>
            </div>
          </div>
        </>
      )}
    </div>
  </div>
</div>
