---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";
import ProductSplit from "./ProductSplit.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="product" class="relative bg-ink-50 py-24 md:py-32">
  <div class="mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-3xl">
      <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">
        04 / {lang === "vi" ? "Bộ mô-đun" : "The suite"}
      </div>
      <h2 class="mt-4 text-balance text-3xl font-bold tracking-tight text-ink-900 md:text-5xl">
        {t("suite.heading")}
      </h2>
      <p class="mt-5 text-lg text-ink-600">{t("suite.kicker")}</p>
    </div>

    <div class="mt-16 space-y-24 md:space-y-32">
      <ProductSplit
        tag="product.gps.tag"
        title="product.gps.title"
        body="product.gps.body"
        bullets={["product.gps.b1", "product.gps.b2", "product.gps.b3"]}
        visual="gps"
      />
      <ProductSplit
        tag="product.dds.tag"
        title="product.dds.title"
        body="product.dds.body"
        bullets={["product.dds.b1", "product.dds.b2", "product.dds.b3"]}
        reverse
        visual="dds"
      />
      <ProductSplit
        tag="product.risk.tag"
        title="product.risk.title"
        body="product.risk.body"
        bullets={["product.risk.b1", "product.risk.b2", "product.risk.b3"]}
        visual="risk"
      />
    </div>
  </div>
</section>
