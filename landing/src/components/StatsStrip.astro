---
import { getLangFromUrl, useTranslations } from "~/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const stats = [
  { key: "s1", color: "text-orange-600" },
  { key: "s2", color: "text-blue-700" },
  { key: "s3", color: "text-green-600" },
] as const;
---

<section class="relative overflow-hidden bg-ink-50 py-20">


  <div class="relative mx-auto max-w-7xl px-6">
    <h2 class="mx-auto max-w-2xl text-center text-2xl font-bold tracking-tight text-ink-900 md:text-3xl">
      {t("stats.heading")}
    </h2>
    <div class="mx-auto mt-12 grid max-w-5xl grid-cols-1 gap-8 sm:grid-cols-3">
      {
        stats.map((s) => (
          <div class="text-center">
            <div class={`text-5xl font-bold tracking-tight ${s.color} md:text-6xl`}>
              {t(`stats.${s.key}.value` as any)}
            </div>
            <div class="mt-3 text-sm text-ink-600">{t(`stats.${s.key}.label` as any)}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>
